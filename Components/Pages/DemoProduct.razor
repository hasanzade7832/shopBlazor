@page "/LearnBlazor/demoProduct"
@using Models

<h2 class="text-primary mb-4">🛒 Product Manager</h2>

<p><strong>Favorite Count:</strong> @FavoriteCount</p>
<p><strong>Selected Product:</strong> @SelectedProduct</p>

<div class="container">
    <div class="row g-3">
        @foreach (var prod in ProductList)
        {
            <_IndividualProduct Product="prod"
                                OnFavoriteUpdated="FavoriteCountChange"
                                OnProductSelectedChange="UpdateSelectedProduct" />
        }
    </div>
</div>

@code {
    private int FavoriteCount { get; set; } = 0;
    public string SelectedProduct { get; set; } = "";

    private void UpdateSelectedProduct(string productName)
    {
        SelectedProduct = productName;
    }

    private void FavoriteCountChange(bool isFavorite)
    {
        if (isFavorite)
            FavoriteCount++;
        else
            FavoriteCount--;
    }

    private List<Product> ProductList = new()
    {
        new Product
        {
            Id = 1,
            Name = "Product 1",
            IsActive = true,
            Price = 5,
            ProductProperties = new List<Product_Prop>
            {
                new Product_Prop { Id = 1, Key = "Color", Value = "Red" },
                new Product_Prop { Id = 2, Key = "Size", Value = "20oz" },
                new Product_Prop { Id = 3, Key = "Flavor", Value = "Rose" }
            }
        },
        new Product
        {
            Id = 2,
            Name = "Product 2",
            IsActive = false,
            Price = 10,
            ProductProperties = new List<Product_Prop>
            {
                new Product_Prop { Id = 1, Key = "Color", Value = "Blue" },
                new Product_Prop { Id = 2, Key = "Size", Value = "18oz" },
                new Product_Prop { Id = 3, Key = "Flavor", Value = "Lily" }
            }
        }
    };
}
