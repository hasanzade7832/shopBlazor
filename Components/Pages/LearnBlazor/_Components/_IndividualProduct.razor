@using Models
@using Microsoft.AspNetCore.Components.Web

<style>
    .selected-product {
        border: 2px solid #28a745;
        background-color: #f0fff4;
        border-radius: 10px;
        transition: all 0.3s ease;
    }
</style>

<div class="col-md-6"
     @onclick="(e) => SelectedProductUpdated(e, Product.Name)">
    <div class="card shadow-sm p-3 mb-4 @(Product.Name == SelectedProductName ? "selected-product" : "")">
        <div class="card-body">
            <h5 class="card-title">
                🛍️ <span class="text-primary">Product #@Product.Id</span>
            </h5>

            <p><strong>📛 Name:</strong> @Product.Name</p>
            <p><strong>💰 Price:</strong> <span class="text-success fw-bold">@Product.Price $</span></p>

            <p>
                <strong>🔄 Status:</strong>
                @if (Product.IsActive)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactive</span>
                }
            </p>

            <div class="form-check mb-3">
                <input type="checkbox"
                       class="form-check-input"
                       id="fav_@Product.Id"
                       @onchange="FavoriteUpdated" />
                <label class="form-check-label" for="fav_@Product.Id">⭐ Add to Favorites</label>
            </div>

            @if (Product.IsActive && Product.ProductProperties?.Any() == true)
            {
                <div class="p-2 border rounded bg-light">
                    <h6 class="text-success mb-2">📦 Properties:</h6>
                    @foreach (var prop in Product.ProductProperties)
                    {
                        <p class="mb-1">
                            <span class="badge bg-info">@prop.Key</span>
                            <span class="ms-2">@prop.Value</span>
                        </p>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public Product Product { get; set; } = default!;
    [Parameter] public EventCallback<bool> OnFavoriteUpdated { get; set; }
    [Parameter] public EventCallback<string> OnProductSelectedChange { get; set; }
    [Parameter] public string SelectedProductName { get; set; } = "";

    private async Task FavoriteUpdated(ChangeEventArgs e)
    {
        var isFavorite = e?.Value as bool? ?? false;
        await OnFavoriteUpdated.InvokeAsync(isFavorite);
    }

    private async Task SelectedProductUpdated(MouseEventArgs e, string productName)
    {
        await OnProductSelectedChange.InvokeAsync(productName);
    }
}
